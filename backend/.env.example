# Copy required values into backend/.env. Never commit real secrets.
PORT=3001
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/anonymous_community_chat
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id

# College Assistant: the key stays on the backend.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Comma-separated MongoDB user IDs permitted to upload/remove college documents.
# Find your ID at the end of your own profile URL after signing in.
CHATBOT_ADMIN_IDS=
